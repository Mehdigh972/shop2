# Copy this file to config.env and edit the values.
# Never commit config.env.

# Generate with: openssl rand -hex 32
HELPER_API_KEY=change-me

GARENA_DOMAIN=shop2game.com
HEADLESS=1

# Raspberry Pi Chromium path. On some systems this is /usr/bin/chromium.
CHROMIUM_PATH=/usr/bin/chromium-browser

# Optional manual browser/noVNC link shown when Shop2Game asks for captcha/verification.
NOVNC_URL=

# Keep this off unless you confirm it helps in your environment.
USE_PLAYWRIGHT_STEALTH=0
BROWSER_LOCALE=en-US
